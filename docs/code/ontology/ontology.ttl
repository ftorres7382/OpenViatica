@prefix faas: <http://semantic-faas.com/ontology#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :   <http://openviatica.org/schema#> .

# OpenViatica
:OpenViatica a owl:Class;
    :name "OpenViatica";
    :description "The OpenViatica featureset, programs & utilities";

    :includes :Ovutils, :OpenViaticaWorkspace

.

# Ovutils
:Ovutils a owl:Class;
    :name "OpenViatica Utilities";
    :description "Provides access to the OpenViaitca utilites and programs";

    :is :OpenViatica;
    
    :restricted_by :CanInitializeOpenViaticaWorkspace;
.

# Restrictions
:CanUseOvutils a owl:Restriction ;
    owl:onProperty :canUse ;
    owl:someValuesFrom :Ovutils ;
    :description "Capability: Ovutils Execution" 
.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :   <http://openviatica.org/schema#> .

# Workspace definition
:Workspace a owl:Class;
    :name "Workspace";
    :description "Anything in the OpenViatica system that can be called a workspace";
    
    :is :Folder;

    :restricted_by :ReqBaseWorkspaceToml;
.

#OpenViatica Workspace
:OpenViaticaWorkspace a owl:Class;
    :name "OpenViatica Workspace";
    :description "A OpenViatica Workspace of workspaces.";


    :is :Workspace;
    :includes :Workspace; 

    

.

# Restrictions
:CanInitializeOpenViaticaWorkspace a owl:Restriction;
    owl:onProperty :canInitialize;
    owl:someValuesFrom :OpenViaticaWorkspace;
    :description "Capability to Initialize an OpenViatica Workspace"  
.


## Workspace Toml
:BaseWorkspaceToml a owl:Class;
    :name "Workspace Toml";
    :description "A Toml file found in the workspace folder that has the minimum metadata for the workspace";

    :restricted_by :ReqConfigID;
    :restricted_by :ReqConfigName;
    :restricted_by :ReqConfigWorkspaceType;
.

## Restrictions
:ReqBaseWorkspaceToml a owl:Restriction;
    owl:onProperty :BaseWorkspaceToml;
    owl:cardinality 1;
.


# Single Items required for workspaces
:ConfigName a owl:DatatypeProperty ; rdfs:range xsd:string .
:ConfigID   a owl:DatatypeProperty ; rdfs:range xsd:string .
:ConfigWorkspaceType a owl:DatatypeProperty; 
    :allowedValue "openviatica", "ov-templates";
.

# Restriction definitions on the single items
:ReqConfigName a owl:Restriction;
    owl:onProperty :ConfigName;
    owl:cardinality 1;
.

:ReqConfigID a owl:Restriction;
    owl:onProperty :ConfigID;
    owl:cardinality 1;
.

:ReqConfigWorkspaceType a owl:Restriction;
    owl:onProperty :ConfigWorkspaceType;
    owl:cardinality 1;
.


@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :   <http://openviatica.org/schema#> .


:canUse a owl:ObjectProperty .

:canIntialize a owl:ObjectProperty .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :   <http://openviatica.org/schema#> .

:is a owl:ObjectProperty ;
    owl:equivalentProperty rdfs:subClassOf 
.

:restricted_by a owl:ObjectProperty ;
    owl:equivalentProperty rdfs:subClassOf 
.

:includes a owl:ObjectProperty ;
    :name "includes" ;
    :description "Indicates that the subject includes the object as a component." ;
    a owl:TransitiveProperty ; 
.

:allowedValue a owl:AnnotationProperty;
    rdfs:label "Allowed Value";
    rdfs:comment "A metadata tag used to list the valid options for a property."
.

## Metadata property aliases 
:name a owl:AnnotationProperty ;
    owl:equivalentProperty rdfs:label 
.

:description a owl:AnnotationProperty ;
    owl:equivalentProperty rdfs:comment 
.

:refers_to a owl:AnnotationProperty ;
    owl:equivalentProperty rdfs:range 
.



@prefix faas: <http://semantic-faas.com/ontology#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :   <http://openviatica.org/schema#> .

:Python a owl:Class;
    :name "Python";
    :description "A programming language";
    
    :restricted_by :CanUseOvutils
.

# Restrictions
:CanUsePython a owl:Restriction ;
    owl:onProperty :canUse ;
    owl:someValuesFrom :Python ;
    :description "Capability: Python Execution" 
.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :   <http://openviatica.org/schema#> .

:Terminal a owl:Class;
    :name "Terminal";
    :description "A computer terminal in Windows or Linux";

    :restricted_by :CanUseOvutils;
.

# Restrictions
:CanUseTerminal a owl:Restriction ;
    owl:onProperty :canUse ;
    owl:someValuesFrom :Terminal ;
    :description "Capability: Terminal Execution";
.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :   <http://openviatica.org/schema#> .

:User a owl:Class ;
    :name "User" ;
    :description "An actor capable of interacting with the OpenViatica system." ;

    # Restrictions
    :restricted_by :CanUseTerminal;
    :restricted_by :CanUsePython;
    :restricted_by :CanUseAPI;
.

